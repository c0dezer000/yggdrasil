{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git *": "deny",
      "sudo *": "deny",
      "npm publish*": "deny",
      "*": "allow"
    }
  }
}
