{
  "_comment": "Copy to .ygg-bridge.json to enable the interactive remote bridge. BOTH 'enabled' and 'agentPinningWaived' must be true before remote prompts are delivered into the visible TUI. Two flags, not one, because turning this on waives a security control: submitting into the TUI runs the prompt under whatever agent that session has selected, so the '--agent ratatoskr' pinning that keeps remote text away from edit/bash does not apply. Read guides/interactive-bridge.md before setting these.",

  "enabled": false,
  "agentPinningWaived": false,

  "url": "http://127.0.0.1:4096",

  "_comment_auth": "Set OPENCODE_SERVER_PASSWORD when starting the server and put the same value here. Without it the server accepts any local client. It binds to loopback so it is not reachable from the network, but any local process could drive an agent holding edit and bash.",
  "username": "opencode",
  "password": null,

  "_comment_timeout": "How long to wait for the session to finish answering before telling the phone it is still working. The prompt is already in the terminal either way.",
  "replyTimeoutSeconds": 300,

  "_comment_select": "Navigate the TUI to the target session before submitting, so the prompt is never delivered to a conversation that is off-screen.",
  "selectSession": true
}
